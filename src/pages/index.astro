---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
import { homeContent } from '../data/site';

const onlineCount = services.filter((service) => service.status === '已上线').length;
---

<Layout>
  <main class="home-stage">
    <div class="ambient-grid" aria-hidden="true"></div>

    <section class="profile-card" aria-label="TTLINK personal ops homepage">
      <p class="kicker">{homeContent.kicker}</p>
      <h1>{homeContent.title}</h1>
      <p class="signature">{homeContent.signature}</p>

      <nav class="link-row" aria-label={homeContent.serviceNavLabel}>
        {services.map((service) => (
          <a href={service.url} target="_blank" rel="noreferrer" aria-label={service.name}>
            <span class:list={['link-status', service.status === '已上线' ? 'online' : 'planned']}></span>
            <span>{service.name}</span>
          </a>
        ))}
      </nav>

      <div class="ops-note" aria-label="运行状态摘要">
        <span>{onlineCount} services online</span>
        {homeContent.statusItems.map((item) => <span>{item}</span>)}
      </div>

      <a class="console-link" href="/about">{homeContent.consoleLabel}</a>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    color: #f8fafc;
    background: #060606;
    font-family:
      "Helvetica Neue",
      "Microsoft Yahei",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    overflow: hidden;
  }

  .home-stage {
    position: relative;
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 28px;
    isolation: isolate;
  }

  .home-stage::before {
    position: absolute;
    inset: -20%;
    z-index: -2;
    content: "";
    background:
      radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.11), transparent 28rem),
      radial-gradient(circle at 30% 70%, rgba(34, 197, 94, 0.1), transparent 22rem),
      radial-gradient(circle at 70% 66%, rgba(56, 189, 248, 0.08), transparent 24rem),
      #060606;
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(circle at center, black 0%, black 42%, transparent 78%);
    opacity: 0.75;
  }

  .profile-card {
    width: min(760px, 100%);
    text-align: center;
    animation: fade-in 520ms ease-out both;
  }

  .kicker {
    margin: 0 0 18px;
    color: #a3a3a3;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(34px, 7vw, 68px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.055em;
    text-shadow: 0 0 26px rgba(255, 255, 255, 0.18);
  }

  .signature {
    margin: 18px 0 46px;
    color: #b6b6b6;
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 300;
    letter-spacing: 0.16em;
  }

  .link-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0 auto;
    padding: 0 0 34px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .link-row a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    color: #b6b6b6;
    text-decoration: none;
    font-size: 15px;
    font-weight: 400;
    transition: color 180ms ease, text-shadow 180ms ease, transform 180ms ease;
  }

  .link-row a + a {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .link-row a:hover {
    color: #ffffff;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.42);
    transform: translateY(-2px);
  }

  .link-status {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #71717a;
  }

  .link-status.online {
    background: #22c55e;
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.8);
  }

  .link-status.planned {
    background: #f59e0b;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.55);
  }

  .ops-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 22px;
    color: #777;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .ops-note span::before {
    content: "// ";
    color: #3f3f46;
  }

  .console-link {
    display: inline-flex;
    margin-top: 28px;
    color: #d4d4d8;
    text-decoration: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
    opacity: 0.72;
    transition: opacity 180ms ease, text-shadow 180ms ease, transform 180ms ease;
  }

  .console-link:hover {
    opacity: 1;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.42);
    transform: translateY(-1px);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 680px) {
    :global(body) {
      overflow: auto;
    }

    .home-stage {
      align-items: start;
      padding-top: 72px;
    }

    .link-row {
      grid-template-columns: 1fr 1fr;
      row-gap: 12px;
    }

    .link-row a:nth-child(odd) {
      border-left: 0;
    }
  }

  @media (max-width: 420px) {
    .link-row {
      grid-template-columns: 1fr;
    }

    .link-row a {
      border-left: 0 !important;
    }
  }
</style>
